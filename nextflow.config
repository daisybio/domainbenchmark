/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    daisybio/domainbenchmark Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/
nextflow.enable.dsl = 2

// Global default params, used in configs
params {
    // For this pipeline

    // -------- I/O --------
    input                         = null
    outdir                        = './results'
    publish_dir_mode              = 'copy'
    // domainsplit's `results/embeddings/` directory, holding one
    // `<model>_domain_embeddings.h5` per embedding model, keyed
    // `h5[pfam_id][instance_id]`. These files are per-RUN, not per-split: they
    // hold every domain the run saw and each split database is a subset of that,
    // so one file serves all of them. Required only when `published_features` is
    // non-empty.
    // Left null the pipeline derives it: domainsplit publishes `embeddings/`
    // as a sibling of the `databases/` directory the split databases live in,
    // so `--input <run>/results/databases` implies `<run>/results/embeddings`.
    // Only a samplesheet input (whose rows can point anywhere) still requires
    // it explicitly. See `embeddingsDir()` in
    // subworkflows/local/per_db_benchmark/main.nf.
    embeddings                    = null
    // Fraction of a split's (pfam_id, instance_id) pairs a published embedding
    // file must resolve before the pairing is accepted. A same-run file resolves
    // ~100% (domainsplit's exporter warns about the handful it drops for
    // --max-len or OOM). Catches an export that does not cover these databases
    // at all. It cannot catch an export from a different *run* over the same
    // domains -- Pfam accessions are stable, so that one resolves like a native
    // file. Pointing --embeddings at the matching run is the caller's job, which
    // the derived default does by construction.
    min_embedding_coverage        = 0.5

    // -------- Pipeline behaviour --------
    modeljson                     = "${projectDir}/assets"
    skip                          = null
    // Comma-separated. main.nf splits on entry. (nf-core schema lint is
    // happier with strings than Groovy lists for default values.)
    graph_models                  = 'kgiddi,ddiparsimony,kgiddi_random'
    // Minimum STRING combined_score (0-1000) a PPI must reach to enter the
    // interactome every graph model builds on. One value for all of them: they
    // are compared against each other, so they must see the same network.
    // 400 is STRING's "medium confidence" band and STRING's own default.
    // Do not raise this without re-checking that each split still yields >= 2
    // union-find clusters -- a split database holds only its own proteins'
    // interactome, and at 900 minimal_leakage/test_balanced kept 2 of 254 PPIs,
    // which collapses KGIDDI's chi2 stratification (see bin/kgiddi.py).
    ppi_score_cutoff              = 400
    machine_learning_models       = 'neural_network,random_forest'
    machine_learning_features     = 'dummy,aacomp,aaencode,esm3_embeddings,esmc_embeddings,prott5_embeddings'
    // Features whose embedding dim makes feature-extraction / NN / RF tasks
    // need the heavy memory-time envelope. Sized per task by the `withName`
    // rules in conf/modules.config; anything not listed gets the default one.
    large_features                = 'esm3_embeddings,esmc_embeddings,prott5_embeddings'
    // Features NOT extracted from the split databases: domainsplit publishes
    // them once per run under --embeddings, one mean-pooled vector per domain
    // instance. They skip FEATURE_EXTRACTION entirely -- see the note on
    // `embeddings` above. Must be a subset of machine_learning_features to have
    // any effect.
    published_features            = 'esm3_embeddings,esmc_embeddings,prott5_embeddings'
    old_report                    = 'evaluation'
    // Comma-separated dataset (run label) order for the MultiQC reports, e.g.
    // 'random_balanced,minimal_leakage_hcni_realistic,external_test'. Drives the
    // section order of the blocks that exist once per dataset, the tab/series
    // order inside the combined ROC/PR and by-source plots, and the column order
    // of the AUC/AP heatmaps. A name that does not exist in the data is a hard
    // failure; a dataset missing from the list warns and is appended
    // alphabetically. Left null everything is alphabetical.
    mqc_order                     = null
    seed                          = 42
    // GPU-only models (RANDOM_FOREST/cuML) normally exit 140 when their CUDA
    // smoke test fails so Nextflow retries on a healthy GPU node. Set true on
    // GPU-less machines (CI, laptops) to train on the CPU instead.
    allow_cpu_ml                  = false

    // Cap on the report attached to the completion email. The report itself is
    // built by bin/eval_multiqc.py, which writes its own MultiQC config -- the
    // pipeline-level MULTIQC process and its assets are gone.
    max_multiqc_email_size     = '25.MB'

    // Boilerplate options
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        // -e HOME: the containers' ENTRYPOINT is `micromamba run -n <env>`, and
        // `-u $(id -u):$(id -g)` gives that uid no home directory, so micromamba
        // fails writing its cache to `/.cache/mamba`. Point HOME at a writable
        // path. (Singularity/Apptainer ignore ENTRYPOINT, so this is docker-only.)
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        // The GPU image (CUDA 12.8 + torch + cuML) is large enough that the
        // 20 min default expires mid-pull on a cold cache.
        singularity.pullTimeout = '2 h'
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.pullTimeout   = '2 h'
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load daisybio/domainbenchmark custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load daisybio/domainbenchmark custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/domainbenchmark.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"

    // Reproducibility, and it has to be set here rather than in Python: the
    // string-hash salt is fixed before the interpreter starts. Without it,
    // iterating a set of domain IDs yields a different order every run, which
    // reorders training rows, the class-balancing draw and the rows of a
    // predictions parquet -- so two runs with the same --seed still diverged.
    PYTHONHASHSEED          = 0
    // Makes cuBLAS reductions order-independent, for torch's deterministic
    // algorithm checks. Read at cuBLAS init, so it must exist before python.
    CUBLAS_WORKSPACE_CONFIG = ":4096:8"
    // Tasks get `bin/` on PATH from the pipeline directory itself, so without
    // this they write __pycache__ back into it. That makes the pipeline
    // directory carry state between runs: the first run after an edit imports
    // from a different cache than the runs after it.
    PYTHONDONTWRITEBYTECODE = 1
    // The native CUDACachingAllocator (the image bakes
    // PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True) calls nvmlInit_v2_ on
    // the first big allocation and asserts on failure. Apptainer/Singularity
    // --nv on the DaiSyBio cluster cannot init NVML (libnvidia-ml version
    // mismatch with the host driver), so the assertion fires mid-forward. The
    // cudaMallocAsync backend bypasses the C++ caching allocator entirely and
    // never touches NVML.
    PYTORCH_CUDA_ALLOC_CONF = "backend:cudaMallocAsync"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'daisybio/domainbenchmark'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Konstantin Pelz',
            affiliation: 'Data Science in Systems Biology, TUM School of Life Sciences, Technical University of Munich, Germany.',
            email: 'konstantin.pelz@tum.de',
            github: 'PelzKo',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0009-0003-3891-2005'
        ],
        [
            name: 'Chiara Thomas',
            affiliation: 'Data Science in Systems Biology, TUM School of Life Sciences, Technical University of Munich, Germany.',
            email: 'ge58rab@mytum.de',
            github: 'chialtho',
            contribution: ['author', 'contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0000-0001-9720-7208'
        ],
        [
            name: 'Christian Romberg',
            affiliation: 'Data Science in Systems Biology, TUM School of Life Sciences, Technical University of Munich, Germany.',
            email: 'c.romberg@tum.de',
            github: 'ChristianRomberg',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0009-0007-8549-153X'
        ],
    ]
    homePage        = 'https://github.com/daisybio/domainbenchmark'
    description     = """Benchmarking Pipeline for Domain-Domain Interaction Prediction Methods"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.2'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
    // NOTE: `lenientMode = true` does NOT fix a CLI `--seed 7` arriving as a
    // String against a `"type": "integer"` schema -- it only widens the other
    // direction (an integer satisfying a string type). The fix is the typed
    // `params { }` declaration block at the top of main.nf.
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
