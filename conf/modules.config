/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode
    ]

    // The per-DB scatter wraps every process in PER_DB_BENCHMARK; {meta.db}
    // (the database name) namespaces outputs so multiple databases write
    // side-by-side under <outdir>/<db_name>/. Everything up to and including
    // model fitting is shared across a database's test variants, so it lives
    // directly under <db_name>/; only the evaluation fans out, into
    // <db_name>/evaluation/<variant>/.

    withName: 'DDI_EXTRACTION' {
        publishDir = [
            path: { "${params.outdir}/${meta.db}/ddi" },
            mode: params.publish_dir_mode,
            // `ddi_out/` only exists to keep the task's output dir from colliding
            // with the staged input database directory; it is not worth
            // publishing, so strip it and keep `ddi/DDI/<split>*.csv`.
            saveAs: { filename -> filename.replaceFirst('^ddi_out/', '') }
        ]
    }

    withName: 'VERIFY_EMBEDDINGS' {
        // Nothing to publish. The output is a symlink to a file that already
        // exists on disk under `--embeddings`, renamed so
        // `machine_learning.resolve_feature_file` finds it as
        // `features/<feature>.h5`. The default publishDir above would resolve
        // that symlink and *copy* a multi-gigabyte embedding file into
        // `results/` once per database -- for a file the user handed us the
        // path to.
        publishDir = [ enabled: false ]
    }

    withName: 'FEATURE_EXTRACTION_ONE' {
        // One `<feature>__<split>.h5` per task, published flat -- the same set
        // of files STAGE_FEATURE_DIR used to copy into a per-feature directory
        // before it was removed.
        publishDir = [
            path: { "${params.outdir}/${meta.db}/data" },
            mode: params.publish_dir_mode
        ]
        // Heavy embedding features (1024-2560-dim) need a much bigger
        // allocation than the default `feature_extraction` label (40 GB).
        // Route them to the same memory/time envelope as `process_gpu_large`
        // (160 GB × task.attempt, 36 h). With maxRetries=3 the ceiling is
        // 480 GB, leaving headroom past the previously-failing 120 GB cap.
        memory = {
            def heavy = (params.large_features ?: '').tokenize(',')*.trim()
            (heavy.contains(meta.feature) ? 160.GB : 40.GB) * task.attempt
        }
        time = {
            def heavy = (params.large_features ?: '').tokenize(',')*.trim()
            (heavy.contains(meta.feature) ? 36.h : 12.h) * task.attempt
        }
    }

    // NN/RF sizing. Both carry only `label 'process_gpu'` -- that label is the
    // hook the institutional config keys on for queue/--gpus, and it must stay
    // a single static label, so the small-vs-large split lives here instead.
    // `withName` outranks `withLabel`, so these win over conf/base.config.
    // A combo containing any `params.large_features` entry (1024-2560-dim
    // embeddings) gets the big envelope; aacomp/aaencode/dummy get the small
    // one. `meta.features` is the list of features in the combo, so the
    // all-feature concat run always lands in the large bucket.
    withName: 'NEURAL_NETWORK|RANDOM_FOREST' {
        memory = {
            def heavy = (params.large_features ?: '').tokenize(',')*.trim()
            (meta.features.any { heavy.contains(it) } ? 160.GB : 40.GB) * task.attempt
        }
        time = {
            def heavy = (params.large_features ?: '').tokenize(',')*.trim()
            (meta.features.any { heavy.contains(it) } ? 36.h : 12.h) * task.attempt
        }
    }

    withName: 'NEURAL_NETWORK' {
        publishDir = [
            path: { "${params.outdir}/${meta.db}/nn_output" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NEURAL_NETWORK_EVALUATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.db}/nn_output_complete_db" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'RANDOM_FOREST' {
        publishDir = [
            path: { "${params.outdir}/${meta.db}/rf_output" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'RANDOM_FOREST_EVALUATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.db}/rf_output_complete_db" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GRAPH_MODEL' {
        publishDir = [
            path: { "${params.outdir}/${meta.db}/graph_models" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'EVAL_ONE' {
        publishDir = [ enabled: false ]   // per-model JSONs only feed the reducer
    }

    withName: 'EVALUATION' {
        // The process emits a directory literally named `evaluation` (COMBINE_EVAL
        // stages it by that name); saveAs renames it to the test variant so both
        // test sets of one database sit side by side.
        publishDir = [
            path: { "${params.outdir}/${meta.db}/evaluation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('evaluation') ? "${meta.variant}" : filename }
        ]
    }

    withName: 'COMBINE_EVAL' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode
        ]
    }
}
