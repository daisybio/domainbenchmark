/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // The per-DB scatter wraps every process in PER_DB_BENCHMARK; the
    // {meta.id} (the database name) is used to namespace outputs so multiple
    // databases write side-by-side under <outdir>/<db_name>/.

    withName: 'DDI_EXTRACTION' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/ddi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STAGE_FEATURE_DIR' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/data" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FEATURE_EXTRACTION_ONE' {
        publishDir = [ enabled: false ]
    }

    withName: 'MACHINE_LEARNING' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/ml_output" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MACHINE_LEARNING_EVALUATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/ml_output_complete_db" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RANDOM_FOREST' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/rf_output" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RANDOM_FOREST_EVALUATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/rf_output_complete_db" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GRAPH_MODEL' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/graph_models" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EVAL_ONE' {
        publishDir = [ enabled: false ]   // per-model JSONs only feed the reducer
    }

    withName: 'EVALUATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMBINE_EVAL' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
