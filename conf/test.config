/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run daisybio/domainbenchmark -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal in-repo fixture used for smoke tests / CI.'

    // I/O — directory form: `random` has two test variants, `external_test`
    // one, so both fan-out paths are covered. Regenerate with
    // `python tests/create_test_data.py --out tests/data/databases`.
    input                         = "${projectDir}/tests/data/databases"
    outdir                        = './results-test'
    // Published per-run embedding files, written by the same generator. Covers
    // the path where a feature comes from domainsplit's export instead of being
    // extracted per split -- including VERIFY_EMBEDDINGS, whose declared-id
    // check needs `domainsplit_run` to match the fixture's root attribute.
    embeddings                    = "${projectDir}/tests/data/embeddings"
    domainsplit_run               = 'fixture-run-0001'

    // Pipeline behaviour: the cheapest extracted feature plus one published
    // one (so the singleton and all-concat combos both mix the two sources),
    // and no graph models.
    machine_learning_features     = 'aacomp,esm3_embeddings'
    published_features            = 'esm3_embeddings'
    large_features                = ''
    graph_models                  = ''
    skip                          = ''

    // No GPU on CI runners / dev laptops: let RANDOM_FOREST train with
    // scikit-learn instead of exiting 140 on the cuML CUDA smoke test.
    allow_cpu_ml                  = true

    // Boilerplate
    seed                          = 42
}
