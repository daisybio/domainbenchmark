/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run daisybio/domainbenchmark -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// The full-data run is GPU-heavy and long, so it belongs on a cluster -- but
// the executor is not this repo's business any more. Launch it with the
// institutional config, e.g.
//   nextflow run . -profile test_full,apptainer,gpu,keep_work -c daisybio.config
//
// A full test runs the pipeline defaults from nextflow.config: every sequence
// and structure feature (dummy included), every ML model. Only the input and
// the graph models differ. --embeddings and --structures are derived from the
// directory input (embeddings/ and structures/ beside databases/).

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full benchmark across every database of the current domainsplit run'

    input        = '/nfs/proj/CoBiNet_Masterpraktikum/new_run/domainsplit/results_new_test_struct/databases'
    outdir       = 'results-test-full'

    // Graph models are deprecated and off everywhere.
    graph_models = ''
}
