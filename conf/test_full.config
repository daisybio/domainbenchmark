/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run daisybio/domainbenchmark -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// The full-data run is GPU-heavy and long, so it belongs on a cluster -- but
// the executor is not this repo's business any more. Launch it with the
// institutional config, e.g.
//   nextflow run . -profile test_full,apptainer,gpu,keep_work -c daisybio.config

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full benchmark across all cluster DB splits'

    input        = "${projectDir}/assets/samplesheet_full.csv"

    outdir       = 'results-test-full'
    skip         = ''
    seed         = 42

    machine_learning_features = 'aacomp,aaencode,esm3_embeddings,esmc_embeddings,prott5_embeddings'

    // The three embedding features are published by domainsplit, not extracted
    // here. Point this at the `results/embeddings/` directory of the run that
    // produced the databases in the samplesheet -- VERIFY_EMBEDDINGS rejects a
    // file from any other run, because `domain.id` means something different
    // in each one.
    embeddings   = '/nfs/data/CoBiNet_Masterpraktikum/embeddings'


    graph_models                  = 'kgiddi,ddiparsimony,kgiddi_random'
}
