/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    daisybio/domainbenchmark Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    // Retry on OOM/SIGKILL classes — base memory scales with task.attempt
    // across labels below, so retry 2/3 gets ×2 / ×3 memory automatically.
    // 140 is in the range on purpose: RANDOM_FOREST exits 140 when its cuML
    // CUDA smoke test fails, so the task lands on a healthy GPU node instead.
    // 247 is slurm's OOM kill on the DaiSyBio cluster; it used to be listed in
    // the removed conf/slurm.config and has to live here now.
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 247) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    // Graph models (kgiddi, kgiddi_random, ddiparsimony). kgiddi spends ~5h
    // in build_ddi_network alone and kgiddi_random (permutation control)
    // pushes network_expansion past that — both blew through process_medium's
    // 8h slot on the last cluster run. Inline overrides inside the GRAPH_MODEL
    // process body were silently shadowed because withLabel directives in this
    // config take precedence over per-process directives. Dedicated label.
    withLabel:process_graph {
        cpus   = 18
        memory = { 108.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    // -------- pipeline-specific labels --------
    // `process_gpu` is the only GPU label, and it carries cpu/memory/time
    // sizing only. The GPU *request* itself -- queue, --gpus, qos -- comes from
    // the institutional config the run is launched with (`-c daisybio.config
    // -profile apptainer,gpu`), which keys on exactly this label. There is no
    // executor profile in this repo any more, so nothing here may mention a
    // queue.
    //
    // NN/RF memory and time are overridden per task in conf/modules.config,
    // which sizes them from `params.large_features` -- a 2560-dim embedding
    // combo needs ~4x what aacomp does. `withName` beats `withLabel`, so that
    // closure wins over the values below; these stay as the floor for any
    // future GPU process without a withName rule.
    withLabel: process_gpu {
        cpus   = { 4     * task.attempt }
        memory = { 60.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // Evaluation: scatter is per-prediction (cheap), reducer reads JSONs only.
    withLabel: process_eval_scatter {
        cpus   = { 2     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: process_eval {
        cpus   = { 4     * task.attempt }
        memory = { 60.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // Feature extraction: scatter task per (feature × split).
    withLabel: feature_extraction {
        cpus   = { 4     * task.attempt }
        memory = { 40.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}
