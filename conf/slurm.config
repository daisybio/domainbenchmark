/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    daisybio/domainbenchmark — slurm executor profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Picked up via `-profile slurm`. Pair with `singularity` on the cluster.
    Carries the GPU clusterOptions and retry-on-OOM behaviour from the
    original monolithic nextflow.config.
----------------------------------------------------------------------------*/

workDir = '/nfs/scratch/cobinet/work'

executor {
    name      = 'slurm'
    queueSize = 20
}

process {
    executor      = 'slurm'
    cpus          = 4
    memory        = { 80.GB * task.attempt }
    time          = { 24.h  * task.attempt }
    errorStrategy = { task.exitStatus in [137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 3

    // ------- GPU labels -------
    // ML/RF pick `process_gpu_small` for aacomp/aaencode and
    // `process_gpu_large` when any feature in the combo lives in
    // `params.large_features` (1024-2560-dim embeddings).
    withLabel: 'process_gpu' {
        queue          = 'shared-gpu'
        memory         = { 60.GB * task.attempt }
        time           = { 24.h  * task.attempt }
        clusterOptions = '--gpus-per-task=1 --ntasks=1 --qos=limitgpus --nodelist=jlab-gpu01.exbio.wzw.tum.de,gpu02.exbio.wzw.tum.de,compms-gpu-2.exbio.wzw.tum.de'
    }
    withLabel: 'process_gpu_small' {
        queue          = 'shared-gpu'
        memory         = { 40.GB * task.attempt }
        time           = { 12.h  * task.attempt }
        clusterOptions = '--gpus-per-task=1 --ntasks=1 --qos=limitgpus --nodelist=jlab-gpu01.exbio.wzw.tum.de,gpu02.exbio.wzw.tum.de,compms-gpu-2.exbio.wzw.tum.de'
    }
    withLabel: 'process_gpu_large' {
        queue          = 'shared-gpu'
        memory         = { 160.GB * task.attempt }
        time           = { 36.h   * task.attempt }
        clusterOptions = '--gpus-per-task=1 --ntasks=1 --qos=limitgpus --nodelist=jlab-gpu01.exbio.wzw.tum.de,gpu02.exbio.wzw.tum.de,compms-gpu-2.exbio.wzw.tum.de'
    }

    // ------- evaluation -------
    withLabel: 'process_eval_scatter' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: 'process_eval' {
        cpus   = 4
        memory = { 60.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // ------- feature extraction -------
    withLabel: 'feature_extraction' {
        cpus   = 4
        memory = { 40.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: 'feature_stage' {
        cpus   = 1
        memory = { 4.GB   * task.attempt }
        time   = { 30.min * task.attempt }
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/nfs/scratch/singularity_cache'
    runOptions = '--nv --env CONDA_PREFIX=/opt/conda/envs/ml --env CUPY_CUDA_PATH=/opt/conda/envs/ml'
}

conda {
    enabled = false
}
