nextflow_pipeline {

    // Launch-time validation (validateModelParams): each case must fail before
    // any task runs, naming the problem. No snapshot -- nothing is produced.
    name "Launch checks"
    script "../main.nf"
    tag "pipeline"
    tag "launch"

    test("duplicate feature token fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                machine_learning_features = 'aacomp,dummy,aacomp'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('Feature(s) listed more than once: aacomp') }
        }
    }

    test("structure encoder in machine_learning_features fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                machine_learning_features = 'aacomp,contact_map'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('machine_learning_features lists structure encoder(s) contact_map') }
        }
    }

    test("list param given as '' fails before schema validation") {

        when {
            params {
                outdir = "$outputDir"
                graph_models = true   // what `--graph_models ''` arrives as
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("--graph_models arrived as Boolean") }
        }
    }

    test("structure_informed_features outside published_features fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                structure_informed_features = 'aacomp'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('structure_informed_features lists aacomp, which is not in published_features') }
        }
    }

    test("--seeds with a repeated seed fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = '42,42'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("--seeds '42,42': seed 42 given more than once") }
        }
    }

    test("--seeds with a non-integer fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = '42,4a'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("'4a' is not an integer") }
        }
    }

    test("--seeds with an empty token fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = '42,'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("--seeds '42,': '' is not an integer") }
        }
    }

    test("--seeds with a negative seed fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = '-1'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("'-1' is not an integer") }
        }
    }

    test("--seeds above 2^31-1 fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = '2147483648'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("'2147483648' is not an integer") }
        }
    }

    test("--seeds none fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = 'none'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("'none' is not an integer") }
        }
    }

    test("bare --seeds fails at launch") {

        when {
            params {
                outdir = "$outputDir"
                seeds = true   // what a bare `--seeds` arrives as
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains("--seeds arrived without a value") }
        }
    }

    test("--seeds as an Integer (params file `seeds: 42`) passes validation") {

        // Stopped by the duplicate-feature check, which runs after parseSeeds()
        // and schema validation: reaching it means both accepted the value.
        when {
            params {
                outdir = "$outputDir"
                seeds = 42
                machine_learning_features = 'aacomp,dummy,aacomp'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('Feature(s) listed more than once: aacomp') }
        }
    }

    test("two 1:1 test sets next to a 1:k one fail at launch") {

        // W-10 pairs every 1:k test set with the single 1:1 one. Only the file
        // names are read at launch, so empty files are enough.
        when {
            params {
                def db = new File("${outputDir}/ambiguous/db")
                db.mkdirs()
                ['train', 'validation', 'test_matched_1_1', 'test_uniform_1_1', 'test_uniform_1_10'].each {
                    new File(db, "${it}.sqlite3").text = ''
                }
                outdir = "$outputDir"
                input = "${outputDir}/ambiguous"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('has 2 1:1 test sets (test_matched_1_1.sqlite3, test_uniform_1_1.sqlite3) next to 1:k test set(s) test_uniform_1_10.sqlite3') }
        }
    }

    test("--seeds 42,43 passes validation") {

        // Stopped by the duplicate-feature check, which runs after parseSeeds()
        // and schema validation: reaching it means both accepted the value.
        when {
            params {
                outdir = "$outputDir"
                seeds = ' 42, 43'
                machine_learning_features = 'aacomp,dummy,aacomp'
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).any { it.contains('Feature(s) listed more than once: aacomp') }
        }
    }
}
