FROM mambaorg/micromamba:1.5.10

# Build from the repo root: docker build -f docker/Dockerfile.general -t konstantinpelz/domainbenchmark-general:1.0.1 .
LABEL org.opencontainers.image.source="https://github.com/daisybio/domainbenchmark"
LABEL org.opencontainers.image.version="1.0.1"
LABEL org.opencontainers.image.description="general CPU container (multiqc, scikit-learn, networkx, h5py)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# procps provides `ps` for Nextflow metrics
USER root
RUN apt-get update && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

ENV ENV_NAME=general
ENV PATH=/opt/conda/envs/${ENV_NAME}/bin:$PATH
ENV PYTHONUNBUFFERED=1

COPY --chown=$MAMBA_USER:$MAMBA_USER environments/general.yml /tmp/env.yml
RUN micromamba create -y -n ${ENV_NAME} -f /tmp/env.yml \
 && micromamba clean --all --yes

ENTRYPOINT ["micromamba", "run", "-n", "general"]
CMD ["python"]
