FROM mambaorg/micromamba:1.5.10

# Build from the repo root: docker build -f docker/Dockerfile.gpu -t konstantinpelz/domainbenchmark-gpu:1.0.2 .
LABEL org.opencontainers.image.source="https://github.com/daisybio/domainbenchmark"
LABEL org.opencontainers.image.version="1.0.2"
LABEL org.opencontainers.image.description="GPU container (CUDA 13.4, cuML 26.10, torch 2.14, skorch 1.4)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# procps provides `ps` for Nextflow metrics
USER root
RUN apt-get update && apt-get install -y --no-install-recommends procps gzip \
 && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

ENV ENV_NAME=ml
ENV PATH=/opt/conda/envs/${ENV_NAME}/bin:$PATH
ENV CONDA_PREFIX=/opt/conda/envs/${ENV_NAME}
ENV CUPY_CUDA_PATH=/opt/conda/envs/${ENV_NAME}
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_TF32_OVERRIDE=0
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

COPY --chown=$MAMBA_USER:$MAMBA_USER environments/ml.yml /tmp/env.yml
# no GPU at build time; the CUDA pytorch build needs the __cuda virtual package
RUN CONDA_OVERRIDE_CUDA=13.4 micromamba create -y -n ${ENV_NAME} -f /tmp/env.yml \
 && micromamba clean --all --yes

ENTRYPOINT ["micromamba", "run", "-n", "ml"]
CMD ["python"]
